# =============================================================================
# 环境变量模板
# -----------------------------------------------------------------------------
# 用法：复制成同目录的 .env（.env 已被 .gitignore 忽略，不会提交）
#   cp .env.example .env
# 不复制也能跑——docker-compose.yml 里每项都写了默认值，这里只是方便覆盖。
# =============================================================================

# 宿主机端口。本机 3306 已空闲（旧的 MySQL 5.0 已清理），保持与文档一致
MYSQL_PORT=3306

# 仅本地演示用。真实环境应通过 secrets / 环境注入，不要写进仓库
MYSQL_ROOT_PASSWORD=root123

# 内存上限，与 docs/04 §4 的预算表对应（合计 8.8GB / 上限 10GB）
MYSQL_MEM_LIMIT=768m
