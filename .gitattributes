# 自动识别文本文件，统一换行策略，避免 Windows / macOS 协作时整文件 diff
* text=auto

# 脚本与配置文件强制 LF，保证在 Linux 容器内可直接执行
*.sh      text eol=lf
*.sql     text eol=lf
*.py      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.json    text eol=lf
Dockerfile text eol=lf

# Windows 批处理保留 CRLF
*.bat     text eol=crlf
*.ps1     text eol=crlf

# 二进制文件不做换行处理
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.xlsx    binary
*.docx    binary
*.pdf     binary

# 让 GitHub 语言统计忽略原始数据目录
data/raw/** linguist-vendored
